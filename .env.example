# Copy this file to .env and fill in real values.
# .env is gitignored (see .gitignore). Never commit a real API key.

# --- OlmoEarth Studio ---
# Bearer token for the Studio HTTP API.
# Obtain from Studio UI -> top-right profile menu -> My Profile -> API Keys
# -> Create new API key. The full key is shown ONCE on creation; recreate
# if lost. Max 10 keys per account.
# Docs: https://docs.olmoearth.allenai.org/authentication/
OLMOEARTH_API_KEY=replace-me

# Optional: override the Studio base URL.
# Default lives at https://olmoearth.allenai.org/api/v1
# OLMOEARTH_BASE_URL=https://olmoearth.allenai.org/api/v1

# --- Planetary Computer (optional, for STAC asset signing) ---
# Most read queries are anonymous; signing high-volume asset URLs benefits
# from a subscription key. Docs: https://planetarycomputer.microsoft.com/docs/concepts/sas/
# PC_SDK_SUBSCRIPTION_KEY=

# --- NASA Earthdata (optional, for CMR-gated collections) ---
# EARTHDATA_TOKEN=

# --- Hugging Face (optional, for gated model / dataset access) ---
# HF_TOKEN=

# Optional: override the host HuggingFace cache that docker/llama.compose.yml
# bind-mounts (the ~17.7 GB GGUF lands here once and is reused). `make serve`
# auto-detects this; only set it for a hand-run `docker compose up` from a shell
# where $HOME is unset (Windows PowerShell/cmd), e.g.:
# HF_CACHE_DIR=C:/Users/<you>/.cache/huggingface
#
# Optional: proxy for a genuine FIRST-RUN model download only. From inside the
# container 127.0.0.1 is the container, so target the host alias:
# HF_PROXY=http://host.docker.internal:7897

# --- LLM serving (see docs/serving.md; canonical values in docs/CANON.md) ---
# Local llama.cpp server (OpenAI-compatible) serving the 4-bit GGUF.
LLM_ENDPOINT=http://localhost:8000/v1
LLM_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:UD-IQ4_XS

# Optional: the local server needs no auth. The OpenAI SDK rejects empty
# strings, so the agent uses "EMPTY" when this is unset.
# LLM_API_KEY=EMPTY

# --- Agent harness (optional; Shippy-style soul/config separation) ---
# Swap the agent's soul (system prompt + guardrails) without a code change.
# Defaults to the packaged src/olmoearth_agent/harness/soul.md.
# OLMOEARTH_SOUL_PATH=/path/to/custom_soul.md

# Tool results whose JSON exceeds this many bytes are written to
# <workspace>/tool_results/ and the model gets a compact preview envelope
# instead (0 disables spilling). Default 20000.
# OLMOEARTH_TOOL_RESULT_SPILL_BYTES=20000

# Final answers are concise by default. "auto" honors an explicit user request
# for a detailed / step-by-step report; pin "concise" or "detailed" to override.
# The token ceiling applies to each agent-model turn (reasoning + tool call or
# answer), replacing the generic client's much larger 32768-token allowance.
# OLMOEARTH_RESPONSE_STYLE=auto
# OLMOEARTH_RESPONSE_MAX_WORDS=120
# OLMOEARTH_AGENT_MAX_OUTPUT_TOKENS=4096

# --- Asta (optional; Ai2 full-text literature search) ---
# When the Asta CLI (github.com/allenai/asta-plugins) is installed and
# authenticated ('asta auth login'), olmoearth_litsearch accepts
# source="asta" for full-text ranked search with relevance judgements.
# Override the binary or the per-search wall-clock cap if needed:
# OLMOEARTH_ASTA_BIN=asta
# OLMOEARTH_ASTA_TIMEOUT=180
