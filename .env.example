# Copy this file to .env and fill in real values.
# .env is gitignored (see .gitignore). Never commit a real API key.

# --- OlmoEarth Studio ---
# Bearer token for the Studio HTTP API.
# Obtain from Studio UI -> top-right profile menu -> My Profile -> API Keys
# -> Create new API key. The full key is shown ONCE on creation; recreate
# if lost. Max 10 keys per account.
# Docs: https://docs.olmoearth.allenai.org/authentication/
OLMOEARTH_API_KEY=replace-me

# Optional: override the Studio base URL.
# Default lives at https://olmoearth.allenai.org/api/v1
# OLMOEARTH_BASE_URL=https://olmoearth.allenai.org/api/v1

# --- Planetary Computer (optional, for STAC asset signing) ---
# Most read queries are anonymous; signing high-volume asset URLs benefits
# from a subscription key. Docs: https://planetarycomputer.microsoft.com/docs/concepts/sas/
# PC_SDK_SUBSCRIPTION_KEY=

# --- NASA Earthdata (optional, for CMR-gated collections) ---
# EARTHDATA_TOKEN=

# --- Hugging Face (optional, for gated model / dataset access) ---
# HF_TOKEN=

# --- vLLM serving (see docs/serving.md) ---
# Local vllm serve listening on the default port.
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4

# Optional: vLLM does not require auth by default. The OpenAI SDK rejects
# empty strings, so the agent uses "EMPTY" when this is unset.
# VLLM_API_KEY=EMPTY
